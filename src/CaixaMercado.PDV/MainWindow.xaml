<Window x:Class="CaixaMercado.PDV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CaixaMercado.PDV.ViewModels"
        xmlns:enums="clr-namespace:CaixaMercado.Domain.Enums;assembly=CaixaMercado.Domain"
        mc:Ignorable="d"
        Title="Caixa Mercado — Frente de Caixa (PDV)"
        Height="768" Width="1280"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding AbrirConsultaCommand}" />
        <KeyBinding Key="F6" Command="{Binding AbrirDescontoCommand}" />
        <KeyBinding Key="F7" Command="{Binding RemoverItemCommand}" />
        <KeyBinding Key="F9" Command="{Binding AbrirPagamentoCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RemoverItemCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelarVendaCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Operacional -->
            <RowDefinition Height="50" />
            <!-- 1: Conteudo Principal do PDV -->
            <RowDefinition Height="*" />
            <!-- 2: Barra de Atalhos -->
            <RowDefinition Height="42" />
            <!-- 3: Footer de Status -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 0. HEADER SUPERIOR DO SISTEMA DE CAIXA -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBlueBrush}" CornerRadius="4" Width="32" Height="32" Margin="0,0,10,0">
                        <TextBlock Text="🛒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CAIXA MERCADO" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="  |  PDV VAREJO" Foreground="#64748B" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <TextBlock Text="FILIAL 01 — MATRIZ" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" />
                    </Border>

                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <TextBlock Text="PDV 01" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" />
                    </Border>

                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OPERADOR: " Foreground="#94A3B8" FontSize="13" />
                            <TextBlock Text="{Binding CaixaAtual.Operador}" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="#065F46" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#34D399" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="CAIXA ABERTO" Foreground="#34D399" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. CORPO PRINCIPAL (PAINEL ESQUERDO E DIREITO) -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="35*" />
            </Grid.ColumnDefinitions>

            <!-- LADO ESQUERDO: CAMPO EAN + CUPOM FISCAL / DATAGRID DE ITENS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Painel de Leitura / Entrada EAN -->
                <Border Grid.Row="0" Style="{StaticResource PdvCardStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Quantidade -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="QTD (F4)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding QuantidadeInput, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="22" FontWeight="Bold" Background="#020617" Foreground="#38BDF8"
                                     BorderBrush="#334155" BorderThickness="2" Padding="8,6" HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <!-- EAN / Código de Barras / PLU -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CÓDIGO DE BARRAS / EAN / PLU (DIGITE OU LEIA NO SCANNER)" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtEanInput"
                                     Text="{Binding EanInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EanTextBoxStyle}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AdicionarItemCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Botão Adicionar -->
                        <Button Grid.Column="4" Content="ENTER ↵" Command="{Binding AdicionarItemCommand}"
                                Background="#3B82F6" Foreground="White" FontSize="16" FontWeight="Bold"
                                Padding="20,0" VerticalAlignment="Bottom" Height="50" />
                    </Grid>
                </Border>

                <!-- Dica EAN e Filtro F2 -->
                <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,10">
                    <DockPanel>
                        <Button Content="🔍 F2 CONSULTAR PRODUTOS" Command="{Binding AbrirConsultaCommand}" Style="{StaticResource ShortcutButtonStyle}" DockPanel.Dock="Right" Padding="8,2" />
                        <TextBlock Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center">
                            <Run Text="💡 Dicas de teste: " FontWeight="Bold" Foreground="#FACC15" />
                            <Run Text="7891234567890 (Arroz)" /> | 
                            <Run Text="7891234567891 (Feijão)" /> | 
                            <Run Text="001 (Banana KG)" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- AREA DE VENDAS EM ANDAMENTO / CUPOM DE ITENS -->
                <Border Grid.Row="2" Style="{StaticResource PdvCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho Venda em Andamento -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="VENDA EM ANDAMENTO" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VendaAtual.TotalItens, StringFormat={}{0} item(ns)}" Foreground="#38BDF8" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- ESTADO DE VENDA CONCLUÍDA COM SUCESSO (FEEDBACK VISUAL 2.5S) -->
                        <Control Grid.Row="1"
                                 Template="{StaticResource VendaConcluidaStateTemplate}"
                                 Visibility="{Binding IsVendaConcluidaVisivel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- ESTADO VAZIO DE CAIXA LIVRE (EMPTY SALE STATE COM CARRINHO VETORIAL) -->
                        <Control Grid.Row="1"
                                 Template="{StaticResource EmptySaleStateTemplate}"
                                 Visibility="{Binding HasNoItens, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- DATAGRID DE ITENS DO CUPOM DA VENDA -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Itens}"
                                  SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                                  Style="{StaticResource PdvDataGridStyle}"
                                  Visibility="{Binding HasItens, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Sequencial}" Width="45" />
                                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoProduto}" Width="90" />
                                <DataGridTextColumn Header="DESCRIÇÃO DO PRODUTO" Binding="{Binding DescricaoProduto}" Width="*" />
                                <DataGridTextColumn Header="QTD" Binding="{Binding Quantidade, StringFormat={}{0:N2}}" Width="75" />
                                <DataGridTextColumn Header="UN" Binding="{Binding Unidade}" Width="50" />
                                <DataGridTextColumn Header="UNITÁRIO R$" Binding="{Binding PrecoUnitario, StringFormat={}{0:N2}}" Width="105" />
                                <DataGridTextColumn Header="DESC R$" Binding="{Binding Desconto, StringFormat={}{0:N2}}" Width="85" />
                                <DataGridTextColumn Header="TOTAL R$" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="115" FontWeight="Bold" Foreground="#34D399" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- LADO DIREITO: RESUMO, ÚLTIMO ITEM E PAINEL DE TOTAL R$ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ÚLTIMO ITEM ADICIONADO -->
                <Border Grid.Row="0" Style="{StaticResource PdvCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ÚLTIMO ITEM ADICIONADO" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding UltimoItemDescricao}" Foreground="#FACC15" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" MinHeight="48" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="VALOR DO ITEM:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UltimoItemTotal, StringFormat=R$ {0:N2}}" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- RESUMO DA VENDA -->
                <Border Grid.Row="2" Style="{StaticResource PdvCardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="RESUMO DA VENDA" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <Button Content="🏷️ F6 DESCONTO" Command="{Binding AbrirDescontoCommand}" Style="{StaticResource ShortcutButtonStyle}" Padding="6,1" FontSize="11" HorizontalAlignment="Right" />
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="QUANTIDADE DE ITENS:" Foreground="#94A3B8" FontSize="13" />
                            <TextBlock Text="{Binding VendaAtual.TotalItens}" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>

                        <Separator Background="#334155" Margin="0,6" />

                        <DockPanel Margin="0,4">
                            <TextBlock Text="SUBTOTAL R$:" Foreground="#94A3B8" FontSize="13" />
                            <TextBlock Text="{Binding VendaAtual.Subtotal, StringFormat={}{0:N2}}" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="DESCONTO R$ (F6):" Foreground="#94A3B8" FontSize="13" />
                            <TextBlock Text="{Binding VendaAtual.Desconto, StringFormat={}{0:N2}}" Foreground="#F59E0B" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="CLIENTE (F3):" Foreground="#94A3B8" FontSize="13" />
                            <TextBlock Text="{Binding ClienteNome}" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- PAINEL DE TOTAL R$ EM ENORME DESTAQUE VISUAL -->
                <Border Grid.Row="4" Background="#020617" BorderBrush="#10B981" BorderThickness="2" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL A PAGAR" Foreground="#94A3B8" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding VendaAtual.Total, StringFormat=R$ {0:N2}}"
                                       Foreground="#34D399" FontSize="44" FontWeight="Black"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BOTÃO DE AÇÃO F9 PAGAMENTO -->
                <Button Grid.Row="5"
                        Content="[ F9 ] PAGAMENTO ➔"
                        Command="{Binding AbrirPagamentoCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Height="60" />
            </Grid>
        </Grid>

        <!-- 2. BARRA INFERIOR DE ATALHOS DE TECLADO DO OPERADOR COM BOTÕES ESTILO KEYCAP -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,1" Padding="6,4">
            <UniformGrid Columns="9" VerticalAlignment="Center">
                <!-- F2 PRODUTO -->
                <Button Command="{Binding AbrirConsultaCommand}" Style="{StaticResource ShortcutButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#080F1E" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F2" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock Text="🛒 Produto" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F3 CLIENTE -->
                <Button Style="{StaticResource ShortcutButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#080F1E" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F3" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock Text="👤 Cliente" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F4 QTD -->
                <Button Style="{StaticResource ShortcutButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#080F1E" BorderBrush="#334155" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F4" Foreground="#94A3B8" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock Text="🔢 Qtd" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F6 DESCONTO -->
                <Button Command="{Binding AbrirDescontoCommand}" Style="{StaticResource ShortcutButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#080F1E" BorderBrush="#FACC15" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F6" Foreground="#FACC15" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock Text="🏷️ Desconto" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F7 CANC ITEM -->
                <Button Command="{Binding RemoverItemCommand}" Style="{StaticResource ShortcutButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#080F1E" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F7" Foreground="#EF4444" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock Text="❌ Canc Item" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F8 CONSULTAR -->
                <Button Command="{Binding AbrirConsultaCommand}" Style="{StaticResource ShortcutButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#080F1E" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F8" Foreground="#38BDF8" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock Text="🔍 Consultar" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F9 PAGAMENTO -->
                <Button Command="{Binding AbrirPagamentoCommand}" Style="{StaticResource ShortcutButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#080F1E" BorderBrush="#34D399" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F9" Foreground="#34D399" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <TextBlock Text="💵 Pagamento" Foreground="#34D399" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- ESC CANCELAR -->
                <Button Command="{Binding CancelarVendaCommand}" Style="{StaticResource ShortcutButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#080F1E" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="ESC" Foreground="#EF4444" FontWeight="Bold" FontSize="10" />
                        </Border>
                        <TextBlock Text="🚫 Cancelar" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- DEL REMOVER -->
                <Button Command="{Binding RemoverItemCommand}" Style="{StaticResource ShortcutButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#080F1E" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="DEL" Foreground="#EF4444" FontWeight="Bold" FontSize="10" />
                        </Border>
                        <TextBlock Text="🗑️ Remover" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>

        <!-- 3. BARRA DE STATUS FOOTER -->
        <Border Grid.Row="3" Background="#0F172A" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VENDA Nº: " Foreground="#64748B" FontSize="12" />
                    <TextBlock Text="{Binding VendaAtual.Numero}" Foreground="#F8FAFC" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" />

                    <TextBlock Text="STATUS: " Foreground="#64748B" FontSize="12" />
                    <TextBlock Text="{Binding MensagemStatus}" Foreground="#FACC15" FontSize="12" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="4,0">
                        <TextBlock Text="ONLINE" Foreground="#34D399" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="  PDV MERCADO v1.0" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MODAL F2: CONSULTA DE PRODUTOS ERP -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsModalConsultaAberta, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#DD0F172A">
            <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="8" Width="750" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🔍 CONSULTA DE PRODUTOS (F2)" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" />
                        <Button Content="✕ ESC" Command="{Binding FecharModalConsultaCommand}" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" />
                    </DockPanel>

                    <!-- Filtro de busca -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FiltroConsulta, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Background="#020617" Foreground="#F8FAFC" BorderBrush="#3B82F6" BorderThickness="2" Padding="8,4" VerticalContentAlignment="Center" />
                        <Button Grid.Column="2" Content="PESQUISAR" Command="{Binding FiltrarProdutosCommand}" Background="#3B82F6" Foreground="White" FontWeight="Bold" Padding="16,8" />
                    </Grid>

                    <!-- Tabela de Produtos -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ProdutosConsulta}"
                              SelectedItem="{Binding ProdutoConsultaSelecionado, Mode=TwoWay}"
                              Style="{StaticResource PdvDataGridStyle}"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="80" />
                            <DataGridTextColumn Header="EAN" Binding="{Binding EAN}" Width="130" />
                            <DataGridTextColumn Header="DESCRIÇÃO DO PRODUTO" Binding="{Binding Descricao}" Width="*" />
                            <DataGridTextColumn Header="UN" Binding="{Binding Unidade}" Width="50" />
                            <DataGridTextColumn Header="PREÇO R$" Binding="{Binding PrecoVenda, StringFormat={}{0:N2}}" Width="100" FontWeight="Bold" Foreground="#34D399" />
                            <DataGridTextColumn Header="ESTOQUE" Binding="{Binding Estoque, StringFormat={}{0:N2}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Botões de Ação -->
                    <UniformGrid Grid.Row="3" Columns="2">
                        <Button Content="CANCELAR (ESC)" Command="{Binding FecharModalConsultaCommand}" Background="#334155" Foreground="White" FontSize="14" FontWeight="Bold" Padding="10" Margin="0,0,6,0" />
                        <Button Content="ADICIONAR SELECIONADO (ENTER)" Command="{Binding AdicionarProdutoConsultaCommand}" Background="#10B981" Foreground="White" FontSize="14" FontWeight="Bold" Padding="10" Margin="6,0,0,0" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL F6: DESCONTO DA VENDA -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsModalDescontoAberto, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#DD0F172A">
            <Border Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="2" CornerRadius="8" Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="🏷️ APLICAR DESCONTO (F6)" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" />
                        <Button Content="✕ ESC" Command="{Binding FecharModalDescontoCommand}" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" />
                    </DockPanel>

                    <TextBlock Text="TIPO DE DESCONTO:" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Valor Fixo R$" IsChecked="{Binding IsDescontoPercentual, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=false}" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" Margin="0,0,20,0" />
                        <RadioButton Content="Percentual %" IsChecked="{Binding IsDescontoPercentual}" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold" />
                    </StackPanel>

                    <TextBlock Text="VALOR DO DESCONTO:" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ValorDescontoInput, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Background="#020617" Foreground="#F59E0B" BorderBrush="#F59E0B" BorderThickness="2" Padding="10,6" Margin="0,0,0,16" />

                    <UniformGrid Columns="2">
                        <Button Content="CANCELAR (ESC)" Command="{Binding FecharModalDescontoCommand}" Background="#334155" Foreground="White" FontSize="14" FontWeight="Bold" Padding="10" Margin="0,0,6,0" />
                        <Button Content="APLICAR (ENTER)" Command="{Binding ConfirmarDescontoCommand}" Background="#F59E0B" Foreground="Black" FontSize="14" FontWeight="Bold" Padding="10" Margin="6,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL ESC: CONFIRMAÇÃO DE CANCELAMENTO DE VENDA -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsModalConfirmarCancelarAberto, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#DD0F172A">
            <Border Background="#1E293B" BorderBrush="#EF4444" BorderThickness="2" CornerRadius="8" Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="⚠️ CANCELAR VENDA COMPLETA?" Foreground="#EF4444" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center" />
                    <TextBlock Text="Todos os itens registrados na venda atual serão removidos. Deseja realmente cancelar?" Foreground="#94A3B8" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20" TextAlignment="Center" />

                    <UniformGrid Columns="2">
                        <Button Content="NÃO (ESC)" Command="{Binding FecharModalCancelarVendaCommand}" Background="#334155" Foreground="White" FontSize="14" FontWeight="Bold" Padding="10" Margin="0,0,6,0" />
                        <Button Content="SIM, CANCELAR" Command="{Binding ConfirmarCancelarVendaCommand}" Background="#EF4444" Foreground="White" FontSize="14" FontWeight="Bold" Padding="10" Margin="6,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL F9: FINALIZAR PAGAMENTO -->
        <Grid Grid.RowSpan="4" Visibility="{Binding IsModalPagamentoAberto, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#CC0F172A">
            <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="8" Width="550" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="FINALIZAR PAGAMENTO (F9)" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" />
                        <Button Content="✕ ESC" Command="{Binding FecharModalPagamentoCommand}" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" Cursor="Hand" />
                    </DockPanel>

                    <!-- Total a Pagar no Modal -->
                    <Border Background="#020617" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock Text="TOTAL DA VENDA:" Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VendaAtual.Total, StringFormat=R$ {0:N2}}" Foreground="#34D399" FontSize="28" FontWeight="Black" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>

                    <!-- Seleção Forma de Pagamento com Atalhos F1-F4 -->
                    <TextBlock Text="FORMA DE PAGAMENTO:" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <Button Content="💵 F1 Dinheiro" Command="{Binding SelecionarFormaPagamentoCommand}" CommandParameter="{x:Static enums:TipoPagamento.Dinheiro}" Style="{StaticResource ShortcutButtonStyle}" Margin="2" Padding="4,8" />
                        <Button Content="📱 F2 PIX" Command="{Binding SelecionarFormaPagamentoCommand}" CommandParameter="{x:Static enums:TipoPagamento.Pix}" Style="{StaticResource ShortcutButtonStyle}" Margin="2" Padding="4,8" />
                        <Button Content="💳 F3 Débito" Command="{Binding SelecionarFormaPagamentoCommand}" CommandParameter="{x:Static enums:TipoPagamento.CartaoDebito}" Style="{StaticResource ShortcutButtonStyle}" Margin="2" Padding="4,8" />
                        <Button Content="💳 F4 Crédito" Command="{Binding SelecionarFormaPagamentoCommand}" CommandParameter="{x:Static enums:TipoPagamento.CartaoCredito}" Style="{StaticResource ShortcutButtonStyle}" Margin="2" Padding="4,8" />
                    </UniformGrid>

                    <!-- Forma Selecionada -->
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="FORMA SELECIONADA:" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TipoPagamentoSelecionado}" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                    </DockPanel>

                    <!-- Campo Valor Recebido -->
                    <TextBlock Text="VALOR RECEBIDO R$:" Foreground="#94A3B8" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ValorPagoInput, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Background="#020617" Foreground="#FACC15" BorderBrush="#3B82F6" BorderThickness="2" Padding="10,6" Margin="0,0,0,16" />

                    <!-- Troco Calculado -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock Text="TROCO R$:" Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TrocoCalculado, StringFormat=R$ {0:N2}}" Foreground="#F59E0B" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>

                    <!-- Mensagem Erro Modal -->
                    <TextBlock Text="{Binding MensagemErroModal}" Foreground="#EF4444" FontSize="13" FontWeight="Bold" Visibility="{Binding HasMensagemErroModal, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10" HorizontalAlignment="Center" />

                    <!-- Botões Ação Modal -->
                    <UniformGrid Columns="2">
                        <Button Content="CANCELAR (ESC)" Command="{Binding FecharModalPagamentoCommand}" Background="#334155" Foreground="White" FontSize="14" FontWeight="Bold" Padding="12" Margin="0,0,6,0" />
                        <Button Content="CONFIRMAR (ENTER) ✓" Command="{Binding ConfirmarPagamentoCommand}" Background="#10B981" Foreground="White" FontSize="14" FontWeight="Bold" Padding="12" Margin="6,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
