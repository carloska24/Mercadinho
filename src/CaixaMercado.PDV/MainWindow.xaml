<Window x:Class="CaixaMercado.PDV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CaixaMercado.PDV.ViewModels"
        xmlns:enums="clr-namespace:CaixaMercado.Domain.Enums;assembly=CaixaMercado.Domain"
        mc:Ignorable="d"
        Title="Caixa Mercado — Frente de Caixa (PDV)"
        Height="768" Width="1280"
        MinHeight="720" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewTextInput="MainWindow_PreviewTextInput"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding SelecionarFormaPagamentoCommand}" CommandParameter="{x:Static enums:TipoPagamento.Dinheiro}" />
        <KeyBinding Key="F2" Command="{Binding AbrirConsultaCommand}" />
        <KeyBinding Key="F3" Command="{Binding AtalhoF3Command}" />
        <KeyBinding Key="F4" Command="{Binding AtalhoF4Command}" />
        <KeyBinding Key="F6" Command="{Binding AbrirDescontoCommand}" />
        <KeyBinding Key="F7" Command="{Binding RemoverItemCommand}" />
        <KeyBinding Key="F8" Command="{Binding AtalhoF8Command}" />
        <KeyBinding Key="F9" Command="{Binding AbrirPagamentoCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelarVendaCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header Operacional -->
            <RowDefinition Height="50" />
            <!-- 1: Conteudo Principal do PDV -->
            <RowDefinition Height="*" />
            <!-- 2: Barra de Atalhos -->
            <RowDefinition Height="42" />
            <!-- 3: Footer de Status -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- 0. HEADER SUPERIOR DO SISTEMA DE CAIXA -->
        <Border Grid.Row="0" IsEnabled="{Binding IsBaseInteractionEnabled}" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource AccentBlueBrush}" CornerRadius="4" Width="32" Height="32" Margin="0,0,10,0">
                        <TextBlock Text="🛒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CAIXA MERCADO" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="  |  PDV VAREJO" Foreground="{DynamicResource MutedTextBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAlternarTema"
                            Content="TEMA: ESCURO"
                            Click="AlternarTema_Click"
                            AutomationProperties.Name="Alternar entre tema claro e escuro"
                            Style="{StaticResource ShortcutButtonStyle}"
                            Padding="10,4"
                            Margin="4,0" />
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <TextBlock Text="FILIAL 01 — MATRIZ" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                    </Border>

                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <TextBlock Text="PDV 01" Foreground="{DynamicResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" />
                    </Border>

                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OPERADOR: " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding CaixaAtual.Operador}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SuccessContainerBrush}" CornerRadius="4" Padding="10,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessForegroundBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="CAIXA ABERTO" Foreground="{DynamicResource SuccessForegroundBrush}" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. CORPO PRINCIPAL (PAINEL ESQUERDO E DIREITO) -->
        <Grid Grid.Row="1" IsEnabled="{Binding IsBaseInteractionEnabled}" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="35*" />
            </Grid.ColumnDefinitions>

            <!-- LADO ESQUERDO: CAMPO EAN + CUPOM FISCAL / DATAGRID DE ITENS -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Painel de Leitura / Entrada EAN -->
                <Border Grid.Row="0" Style="{StaticResource PdvCardStyle}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Quantidade -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="QTD (F4)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtQuantidadeInput" Text="{Binding QuantidadeInput, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PdvTextBoxStyle}"
                                     AutomationProperties.Name="Quantidade do próximo produto"
                                     FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"
                                     HorizontalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SolicitarFocoEanCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- EAN / Código de Barras / PLU -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CÓDIGO DE BARRAS / EAN / PLU (DIGITE OU LEIA NO SCANNER)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtEanInput"
                                     Text="{Binding EanInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Código de barras, EAN ou PLU"
                                     Style="{StaticResource EanTextBoxStyle}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AdicionarItemCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <!-- Botão Adicionar -->
                        <Button x:Name="BtnAdicionarProduto" Grid.Column="4" Content="ENTER ↵" Command="{Binding AdicionarItemCommand}"
                                Style="{StaticResource BlueActionButtonStyle}" AutomationProperties.Name="Adicionar produto"
                                FontSize="16" FontWeight="Bold"
                                Padding="20,0" VerticalAlignment="Bottom" Height="50" />
                    </Grid>
                </Border>

                <!-- Dica EAN e Filtro F2 -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,10">
                    <DockPanel>
                        <Button x:Name="BtnConsultarProdutosTopo" Content="F2 CONSULTAR PRODUTOS" Command="{Binding AbrirConsultaCommand}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="F2 consultar produtos" DockPanel.Dock="Right" Padding="8,2" />
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center">
                            <Run Text="Dicas de teste: " FontWeight="Bold" Foreground="{DynamicResource AccentYellowBrush}" />
                            <Run Text="7891234567890 (Arroz)" /> | 
                            <Run Text="7891234567891 (Feijão)" /> | 
                            <Run Text="001 (Banana KG)" />
                        </TextBlock>
                    </DockPanel>
                </Border>

                <!-- AREA DE VENDAS EM ANDAMENTO / CUPOM DE ITENS -->
                <Border Grid.Row="2" Style="{StaticResource PdvCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho Venda em Andamento -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="VENDA EM ANDAMENTO" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VendaAtual.TotalItens, StringFormat={}{0} item(ns)}" Foreground="{DynamicResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- ESTADO DE VENDA CONCLUÍDA COM SUCESSO (FEEDBACK VISUAL 2.5S COM CARRINHO PARTINDO) -->
                        <Control Grid.Row="1"
                                 Template="{StaticResource VendaConcluidaStateTemplate}"
                                 AutomationProperties.Name="Venda finalizada com sucesso"
                                 AutomationProperties.LiveSetting="Assertive"
                                 Visibility="{Binding IsVendaConcluidaVisivel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- ESTADO VAZIO DE CAIXA LIVRE (EMPTY SALE STATE COM CARRINHO VETORIAL - EXIBIDO SOMENTE QUANDO NÃO HÁ ITENS E A VENDA NÃO FOI RECÉM CONCLUÍDA) -->
                        <Control Grid.Row="1"
                                 Template="{StaticResource EmptySaleStateTemplate}"
                                 Visibility="{Binding IsCaixaLivreVisivel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- DATAGRID DE ITENS DO CUPOM DA VENDA -->
                        <DataGrid Grid.Row="1"
                                  x:Name="GridItensVenda"
                                  AutomationProperties.Name="Itens da venda"
                                  ItemsSource="{Binding Itens}"
                                  SelectedItem="{Binding ItemSelecionado, Mode=TwoWay}"
                                  Style="{StaticResource PdvDataGridStyle}"
                                  Visibility="{Binding HasItens, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Sequencial}" Width="45" />
                                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoProduto}" Width="90" />
                                <DataGridTextColumn Header="DESCRIÇÃO DO PRODUTO" Binding="{Binding DescricaoProduto}" Width="*" />
                                <DataGridTextColumn Header="QTD" Binding="{Binding Quantidade, StringFormat={}{0:N2}}" Width="75" />
                                <DataGridTextColumn Header="UN" Binding="{Binding Unidade}" Width="50" />
                                <DataGridTextColumn Header="UNITÁRIO R$" Binding="{Binding PrecoUnitario, StringFormat={}{0:N2}}" Width="105" />
                                <DataGridTextColumn Header="DESC R$" Binding="{Binding Desconto, StringFormat={}{0:N2}}" Width="85" />
                                <DataGridTextColumn Header="TOTAL R$" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="115" ElementStyle="{StaticResource PdvMoneyCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- LADO DIREITO: RESUMO, ÚLTIMO ITEM E PAINEL DE TOTAL R$ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ÚLTIMO ITEM ADICIONADO -->
                <Border Grid.Row="0" Style="{StaticResource PdvCardStyle}">
                    <StackPanel>
                        <TextBlock Text="ÚLTIMO ITEM ADICIONADO" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding UltimoItemDescricao}" Foreground="{DynamicResource AccentYellowBrush}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" MinHeight="48" />
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="VALOR DO ITEM:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UltimoItemTotal, StringFormat=R$ {0:N2}}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- RESUMO DA VENDA -->
                <Border Grid.Row="2" Style="{StaticResource PdvCardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="RESUMO DA VENDA" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" />
                            <Button x:Name="BtnDescontoResumo" Command="{Binding AbrirDescontoCommand}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="F6 aplicar desconto" Padding="6,1" FontSize="11" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M 21.41 11.58 l -9 -9 C 12.05 2.22 11.55 2 11 2 H 4 C 2.9 2 2 2.9 2 4 v 7 c 0 0.55 0.22 1.05 0.59 1.42 l 9 9 c 0.36 0.36 0.86 0.58 1.41 0.58 s 1.05 -0.22 1.41 -0.59 l 7 -7 c 0.37 -0.36 0.59 -0.86 0.59 -1.41 s -0.23 -1.06 -0.59 -1.42 z M 5.5 7 C 4.67 7 4 6.33 4 5.5 S 4.67 4 5.5 4 S 7 4.67 7 5.5 S 6.33 7 5.5 7 z"
                                          Fill="{DynamicResource AccentYellowBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="F6 DESCONTO" Foreground="{DynamicResource AccentYellowBrush}" FontWeight="Bold" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="QUANTIDADE DE ITENS:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding VendaAtual.TotalItens}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>

                        <Separator Background="{DynamicResource CardBorderBrush}" Margin="0,6" />

                        <DockPanel Margin="0,4">
                            <TextBlock Text="SUBTOTAL R$:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding VendaAtual.Subtotal, StringFormat={}{0:N2}}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="DESCONTO R$ (F6):" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding VendaAtual.Desconto, StringFormat={}{0:N2}}" Foreground="{DynamicResource AccentYellowBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>

                        <DockPanel Margin="0,4">
                            <TextBlock Text="CLIENTE (F3):" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock Text="{Binding ClienteNome}" Foreground="{DynamicResource AccentCyanBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- PAINEL DE TOTAL R$ EM ENORME DESTAQUE VISUAL -->
                <Border Grid.Row="4" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="2" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <Grid VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL A PAGAR" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding VendaAtual.Total, StringFormat=R$ {0:N2}}"
                                       Foreground="{DynamicResource AccentGreenBrush}" FontSize="44" FontWeight="Black"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- BOTÃO DE AÇÃO F9 PAGAMENTO -->
                <Button x:Name="BtnPagamentoPrincipal" Grid.Row="5"
                        Command="{Binding AbrirPagamentoCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        AutomationProperties.Name="F9 abrir pagamento"
                        Height="60">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 20 4 H 4 c -1.11 0 -1.99 .89 -1.99 2 L 2 18 c 0 1.11 .89 2 2 2 h 16 c 1.11 0 2 -.89 2 -2 V 6 c 0 -1.11 -.89 -2 -2 -2 z m 0 14 H 4 v -6 h 16 v 6 z m 0 -10 H 4 V 6 h 16 v 2 z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="[ F9 ] PAGAMENTO ➔" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- 2. BARRA INFERIOR DE ATALHOS DE TECLADO DO OPERADOR COM BOTÕES ESTILO KEYCAP E ÍCONES VETORIAIS PHOSPHOR (SEM EMOJIS) -->
        <Border Grid.Row="2" IsEnabled="{Binding IsBaseInteractionEnabled}" Background="{DynamicResource SaleAreaBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,1" Padding="6,4">
            <UniformGrid Columns="9" VerticalAlignment="Center">
                <!-- F2 PRODUTO (ShoppingCart) -->
                <Button Command="{Binding AbrirConsultaCommand}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="F2 Produto">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F2" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <Path Data="M 19 6 H 5.21 L 4.27 2 H 1 V 4 H 2.73 L 6.13 18.47 C 5.45 18.84 5 19.56 5 20.38 C 5 21.48 5.9 22.38 7 22.38 C 8.1 22.38 9 21.48 9 20.38 C 9 19.98 8.88 19.61 8.68 19.31 H 16.32 C 16.12 19.61 16 19.98 16 20.38 C 16 21.48 16.9 22.38 18 22.38 C 19.1 22.38 20 21.48 20 20.38 C 20 19.34 19.2 18.48 18.18 18.4 H 7.21 L 6.74 16.4 H 19 L 22 6 H 19 Z"
                              Fill="{DynamicResource AccentCyanBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Produto" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F3 CLIENTE (UserCircle) -->
                <Button Command="{Binding AtalhoF3Command}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="F3 Cliente">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F3" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 s 4.48 10 10 10 10 -4.48 10 -10 S 17.52 2 12 2 z m 0 4 c 1.93 0 3.5 1.57 3.5 3.5 S 13.93 13 12 13 s -3.5 -1.57 -3.5 -3.5 S 10.07 6 12 6 z m 0 14 c -2.03 0 -3.8 -.85 -5.05 -2.2 c .03 -1.68 3.37 -2.6 5.05 -2.6 s 5.02 .92 5.05 2.6 C 15.8 19.15 14.03 20 12 20 z"
                              Fill="{DynamicResource SecondaryTextBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cliente" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F4 QTD (ListNumbers) -->
                <Button Command="{Binding AtalhoF4Command}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="F4 Quantidade">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F4" Foreground="{DynamicResource SecondaryTextBrush}" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <Path Data="M 3 13 h 2 v -2 H 3 v 2 z m 0 4 h 2 v -2 H 3 v 2 z m 0 -8 h 2 V 7 H 3 v 2 z m 4 4 h 14 v -2 H 7 v 2 z m 0 4 h 14 v -2 H 7 v 2 z M 7 7 v 2 h 14 V 7 H 7 z"
                              Fill="{DynamicResource SecondaryTextBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Qtd" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F6 DESCONTO (Tag) -->
                <Button Command="{Binding AbrirDescontoCommand}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="F6 Desconto">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource AccentYellowBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F6" Foreground="{DynamicResource AccentYellowBrush}" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <Path Data="M 21.41 11.58 l -9 -9 C 12.05 2.22 11.55 2 11 2 H 4 C 2.9 2 2 2.9 2 4 v 7 c 0 0.55 0.22 1.05 0.59 1.42 l 9 9 c 0.36 0.36 0.86 0.58 1.41 0.58 s 1.05 -0.22 1.41 -0.59 l 7 -7 c 0.37 -0.36 0.59 -0.86 0.59 -1.41 s -0.23 -1.06 -0.59 -1.42 z M 5.5 7 C 4.67 7 4 6.33 4 5.5 S 4.67 4 5.5 4 S 7 4.67 7 5.5 S 6.33 7 5.5 7 z"
                              Fill="{DynamicResource AccentYellowBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Desconto" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F7 CANC ITEM (XCircle) -->
                <Button Command="{Binding RemoverItemCommand}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="F7 Cancelar item">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource AccentRedBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F7" Foreground="{DynamicResource AccentRedBrush}" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <Path Data="M 12 2 C 6.47 2 2 6.47 2 12 s 4.47 10 10 10 10 -4.47 10 -10 S 17.53 2 12 2 z m 5 13.59 L 15.59 17 L 12 13.41 L 8.41 17 L 7 15.59 L 10.59 12 L 7 8.41 L 8.41 7 L 12 10.59 L 15.59 7 L 17 8.41 L 13.41 12 L 17 15.59 z"
                              Fill="{DynamicResource AccentRedBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Canc Item" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F8 CONSULTAR (MagnifyingGlass) -->
                <Button Command="{Binding AtalhoF8Command}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="F8 Consultar">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F8" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <Path Data="M 15.5 14 h -.79 l -.28 -.27 C 15.41 12.59 16 11.11 16 9.5 C 16 5.91 13.09 3 9.5 3 S 3 5.91 3 9.5 S 5.91 16 9.5 16 c 1.61 0 3.09 -.59 4.23 -1.57 l .27 .28 v .79 l 5 4.99 L 20.49 19 l -4.99 -5 z m -6 0 C 7.01 14 5 11.99 5 9.5 S 7.01 5 9.5 5 S 14 7.01 14 9.5 S 11.99 14 9.5 14 z"
                              Fill="{DynamicResource AccentCyanBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Consultar" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- F9 PAGAMENTO (CreditCard) -->
                <Button Command="{Binding AbrirPagamentoCommand}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="F9 Pagamento">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="F9" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" />
                        </Border>
                        <Path Data="M 20 4 H 4 c -1.11 0 -1.99 .89 -1.99 2 L 2 18 c 0 1.11 .89 2 2 2 h 16 c 1.11 0 2 -.89 2 -2 V 6 c 0 -1.11 -.89 -2 -2 -2 z m 0 14 H 4 v -6 h 16 v 6 z m 0 -10 H 4 V 6 h 16 v 2 z"
                              Fill="{DynamicResource AccentGreenBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Pagamento" Foreground="{DynamicResource AccentGreenBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- ESC CANCELAR (Prohibit) -->
                <Button Command="{Binding CancelarVendaCommand}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Esc Cancelar venda">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource AccentRedBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="ESC" Foreground="{DynamicResource AccentRedBrush}" FontWeight="Bold" FontSize="10" />
                        </Border>
                        <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 s 4.48 10 10 10 10 -4.48 10 -10 S 17.52 2 12 2 z m 0 18 c -4.42 0 -8 -3.58 -8 -8 0 -1.85 .63 -3.55 1.69 -4.9 L 16.9 18.31 C 15.55 19.37 13.85 20 12 20 z m 6.31 -3.1 L 7.1 5.69 C 8.45 4.63 10.15 4 12 4 c 4.42 0 8 3.58 8 8 0 1.85 -.63 3.55 -1.69 4.9 z"
                              Fill="{DynamicResource AccentRedBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Cancelar" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- DEL REMOVER (Trash) -->
                <Button Command="{Binding RemoverItemCommand}" Style="{StaticResource ShortcutButtonStyle}" AutomationProperties.Name="Delete Remover item">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource AccentRedBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0">
                            <TextBlock Text="DEL" Foreground="{DynamicResource AccentRedBrush}" FontWeight="Bold" FontSize="10" />
                        </Border>
                        <Path Data="M 6 19 c 0 1.1 .9 2 2 2 h 8 c 1.1 0 2 -.9 2 -2 V 7 H 6 v 12 z M 19 4 h -3.5 l -1 -1 h -5 l -1 1 H 5 v 2 h 14 V 4 z"
                              Fill="{DynamicResource AccentRedBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Remover" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>

        <!-- 3. BARRA DE STATUS FOOTER -->
        <Border Grid.Row="3" IsEnabled="{Binding IsBaseInteractionEnabled}" Background="{DynamicResource SaleAreaBackgroundBrush}" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VENDA Nº: " Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                    <TextBlock Text="{Binding VendaAtual.Numero}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,16,0" />

                    <TextBlock Text="STATUS: " Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                    <TextBlock x:Name="TxtStatusOperacao" Text="{Binding MensagemStatus}" AutomationProperties.Name="{Binding MensagemStatus}" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource AccentYellowBrush}" FontSize="12" FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="3" Padding="6,2" Margin="4,0">
                        <TextBlock Text="ONLINE" Foreground="{DynamicResource AccentGreenBrush}" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="  PDV MERCADO v1.0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MODAL F2: CONSULTA DE PRODUTOS ERP -->
        <GroupBox x:Name="ModalConsultaProdutos" Grid.RowSpan="4" Visibility="{Binding IsModalConsultaAberta, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ModalOverlayStyle}"
              AutomationProperties.Name="Diálogo de consulta de produtos" AutomationProperties.HelpText="Pesquise, selecione e adicione um produto à venda"
              FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="2" CornerRadius="8" Width="750" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="CONSULTA DE PRODUTOS (F2)" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" />
                        <Button x:Name="BtnFecharConsulta" Content="FECHAR — ESC" Command="{Binding FecharModalConsultaCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="Fechar consulta de produtos" FontSize="14" HorizontalAlignment="Right" />
                    </DockPanel>

                    <!-- Filtro de busca -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtFiltroConsulta" Grid.Column="0" Text="{Binding FiltroConsulta, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PdvTextBoxStyle}" AutomationProperties.Name="Pesquisar produto por código ou descrição" FontSize="16" Padding="8,4" />
                        <Button x:Name="BtnPesquisarProduto" Grid.Column="2" Content="PESQUISAR" Command="{Binding FiltrarProdutosCommand}" Style="{StaticResource BlueActionButtonStyle}" AutomationProperties.Name="Pesquisar produtos" Padding="16,8" />
                    </Grid>

                    <!-- Tabela de Produtos -->
                    <DataGrid Grid.Row="2"
                              x:Name="GridProdutosConsulta"
                              AutomationProperties.Name="Resultados da consulta de produtos"
                              ItemsSource="{Binding ProdutosConsulta}"
                              SelectedItem="{Binding ProdutoConsultaSelecionado, Mode=TwoWay}"
                              Style="{StaticResource PdvDataGridStyle}"
                              Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="80" />
                            <DataGridTextColumn Header="EAN" Binding="{Binding EAN}" Width="130" />
                            <DataGridTextColumn Header="DESCRIÇÃO DO PRODUTO" Binding="{Binding Descricao}" Width="*" />
                            <DataGridTextColumn Header="UN" Binding="{Binding Unidade}" Width="50" />
                            <DataGridTextColumn Header="PREÇO R$" Binding="{Binding PrecoVenda, StringFormat={}{0:N2}}" Width="100" ElementStyle="{StaticResource PdvMoneyCellTextStyle}" />
                            <DataGridTextColumn Header="ESTOQUE" Binding="{Binding Estoque, StringFormat={}{0:N2}}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Botões de Ação -->
                    <UniformGrid Grid.Row="3" Columns="2">
                        <Button x:Name="BtnCancelarConsulta" Content="CANCELAR (ESC)" Command="{Binding FecharModalConsultaCommand}" Style="{StaticResource NeutralButtonStyle}" AutomationProperties.Name="Cancelar consulta" FontSize="14" Padding="10" Margin="0,0,6,0" />
                        <Button x:Name="BtnAdicionarProdutoConsulta" Content="ADICIONAR SELECIONADO (ENTER)" Command="{Binding AdicionarProdutoConsultaCommand}" IsDefault="True" Style="{StaticResource SuccessActionButtonStyle}" AutomationProperties.Name="Adicionar produto selecionado" FontSize="14" Padding="10" Margin="6,0,0,0" />
                    </UniformGrid>
                </Grid>
            </Border>
        </GroupBox>

        <!-- MODAL F3: IDENTIFICAÇÃO SIMPLES DO CLIENTE -->
        <GroupBox x:Name="ModalIdentificarCliente" Grid.RowSpan="4" Visibility="{Binding IsModalClienteAberto, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ModalOverlayStyle}"
              AutomationProperties.Name="Diálogo de identificação do cliente"
              FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="2" CornerRadius="8" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="IDENTIFICAR CLIENTE (F3)" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" />
                        <Button x:Name="BtnFecharCliente" Content="FECHAR — ESC" Command="{Binding FecharModalClienteCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="Fechar identificação do cliente" FontSize="14" HorizontalAlignment="Right" />
                    </DockPanel>

                    <TextBlock Text="NOME DO CLIENTE:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtClienteNome"
                             Text="{Binding ClienteNomeInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PdvTextBoxStyle}"
                             AutomationProperties.Name="Nome do cliente"
                             FontSize="18"
                             Padding="10,7"
                             Margin="0,0,0,8" />
                    <TextBlock Text="Deixe em branco para usar consumidor não identificado."
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,0,0,16" />

                    <UniformGrid Columns="2">
                        <Button x:Name="BtnCancelarCliente" Content="CANCELAR (ESC)" Command="{Binding FecharModalClienteCommand}" Style="{StaticResource NeutralButtonStyle}" AutomationProperties.Name="Cancelar identificação do cliente" FontSize="14" Padding="10" Margin="0,0,6,0" />
                        <Button x:Name="BtnConfirmarCliente" Content="CONFIRMAR (ENTER)" Command="{Binding ConfirmarClienteCommand}" IsDefault="True" Style="{StaticResource BlueActionButtonStyle}" AutomationProperties.Name="Confirmar cliente" FontSize="14" Padding="10" Margin="6,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </GroupBox>

        <!-- MODAL F6: DESCONTO DA VENDA -->
        <GroupBox x:Name="ModalDesconto" Grid.RowSpan="4" Visibility="{Binding IsModalDescontoAberto, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ModalOverlayStyle}"
              AutomationProperties.Name="Diálogo de desconto da venda"
              FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentYellowBrush}" BorderThickness="2" CornerRadius="8" Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="APLICAR DESCONTO (F6)" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" />
                        <Button x:Name="BtnFecharDesconto" Content="FECHAR — ESC" Command="{Binding FecharModalDescontoCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="Fechar desconto" FontSize="14" HorizontalAlignment="Right" />
                    </DockPanel>

                    <TextBlock Text="TIPO DE DESCONTO:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="RdoDescontoFixo" Content="Valor Fixo R$" GroupName="TipoDesconto" IsChecked="{Binding IsDescontoValorFixo}" Style="{StaticResource PdvRadioButtonStyle}" AutomationProperties.Name="Desconto em valor fixo" FontSize="14" Margin="0,0,20,0" />
                        <RadioButton x:Name="RdoDescontoPercentual" Content="Percentual %" GroupName="TipoDesconto" IsChecked="{Binding IsDescontoPercentual}" Style="{StaticResource PdvRadioButtonStyle}" AutomationProperties.Name="Desconto percentual" FontSize="14" />
                    </StackPanel>

                    <TextBlock Text="VALOR DO DESCONTO:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtValorDesconto" Text="{Binding ValorDescontoInput, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Style="{StaticResource PdvTextBoxStyle}" AutomationProperties.Name="Valor do desconto" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentYellowBrush}" Padding="10,6" Margin="0,0,0,16" />

                    <UniformGrid Columns="2">
                        <Button x:Name="BtnCancelarDesconto" Content="CANCELAR (ESC)" Command="{Binding FecharModalDescontoCommand}" Style="{StaticResource NeutralButtonStyle}" AutomationProperties.Name="Cancelar desconto" FontSize="14" Padding="10" Margin="0,0,6,0" />
                        <Button x:Name="BtnAplicarDesconto" Content="APLICAR (ENTER)" Command="{Binding ConfirmarDescontoCommand}" IsDefault="True" Style="{StaticResource WarningActionButtonStyle}" AutomationProperties.Name="Aplicar desconto" FontSize="14" Padding="10" Margin="6,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </GroupBox>

        <!-- MODAL ESC: CONFIRMAÇÃO DE CANCELAMENTO DE VENDA -->
        <GroupBox x:Name="ModalCancelarVenda" Grid.RowSpan="4" Visibility="{Binding IsModalConfirmarCancelarAberto, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ModalOverlayStyle}"
              AutomationProperties.Name="Diálogo de confirmação do cancelamento da venda"
              FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentRedBrush}" BorderThickness="2" CornerRadius="8" Width="450" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <StackPanel>
                    <TextBlock Text="CANCELAR VENDA COMPLETA?" Foreground="{DynamicResource DangerForegroundBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center" />
                    <TextBlock Text="Todos os itens registrados na venda atual serão removidos. Deseja realmente cancelar?" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,20" TextAlignment="Center" />

                    <UniformGrid Columns="2">
                        <Button x:Name="BtnNaoCancelarVenda" Content="NÃO (ESC)" Command="{Binding FecharModalCancelarVendaCommand}" IsDefault="True" Style="{StaticResource NeutralButtonStyle}" AutomationProperties.Name="Não cancelar a venda" FontSize="14" Padding="10" Margin="0,0,6,0" />
                        <Button x:Name="BtnConfirmarCancelarVenda" Content="SIM, CANCELAR" Command="{Binding ConfirmarCancelarVendaCommand}" Style="{StaticResource DangerActionButtonStyle}" AutomationProperties.Name="Confirmar cancelamento da venda" FontSize="14" Padding="10" Margin="6,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </GroupBox>

        <!-- MODAL F9: FINALIZAR PAGAMENTO -->
        <GroupBox x:Name="ModalPagamento" Grid.RowSpan="4" Visibility="{Binding IsModalPagamentoAberto, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ModalOverlayStyle}"
              AutomationProperties.Name="Diálogo de finalização do pagamento"
              FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle">
            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="2" CornerRadius="8" Width="550" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="FINALIZAR PAGAMENTO (F9)" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button x:Name="BtnFecharPagamento" Content="FECHAR — ESC" Command="{Binding FecharModalPagamentoCommand}" Style="{StaticResource GhostButtonStyle}" AutomationProperties.Name="Fechar pagamento" FontSize="14" HorizontalAlignment="Right" />
                    </DockPanel>

                    <!-- Total a Pagar no Modal -->
                    <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock Text="TOTAL DA VENDA:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VendaAtual.Total, StringFormat=R$ {0:N2}}" Foreground="{DynamicResource AccentGreenBrush}" FontSize="28" FontWeight="Black" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>

                    <!-- Seleção Forma de Pagamento com Atalhos F1-F4 -->
                    <TextBlock Text="FORMA DE PAGAMENTO:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <RadioButton x:Name="BtnPagamentoDinheiro" Content="F1  Dinheiro" GroupName="FormaPagamento" Command="{Binding SelecionarFormaPagamentoCommand}" CommandParameter="{x:Static enums:TipoPagamento.Dinheiro}" IsChecked="{Binding IsPagamentoDinheiroSelecionado, Mode=TwoWay}" Style="{StaticResource PaymentMethodRadioStyle}" AutomationProperties.Name="F1 Dinheiro" />
                        <RadioButton x:Name="BtnPagamentoPix" Content="F2  PIX" GroupName="FormaPagamento" Command="{Binding SelecionarFormaPagamentoCommand}" CommandParameter="{x:Static enums:TipoPagamento.Pix}" IsChecked="{Binding IsPagamentoPixSelecionado, Mode=TwoWay}" Style="{StaticResource PaymentMethodRadioStyle}" AutomationProperties.Name="F2 PIX" />
                        <RadioButton x:Name="BtnPagamentoDebito" Content="F3  Débito" GroupName="FormaPagamento" Command="{Binding SelecionarFormaPagamentoCommand}" CommandParameter="{x:Static enums:TipoPagamento.CartaoDebito}" IsChecked="{Binding IsPagamentoDebitoSelecionado, Mode=TwoWay}" Style="{StaticResource PaymentMethodRadioStyle}" AutomationProperties.Name="F3 Débito" />
                        <RadioButton x:Name="BtnPagamentoCredito" Content="F4  Crédito" GroupName="FormaPagamento" Command="{Binding SelecionarFormaPagamentoCommand}" CommandParameter="{x:Static enums:TipoPagamento.CartaoCredito}" IsChecked="{Binding IsPagamentoCreditoSelecionado, Mode=TwoWay}" Style="{StaticResource PaymentMethodRadioStyle}" AutomationProperties.Name="F4 Crédito" />
                    </UniformGrid>

                    <!-- Forma Selecionada -->
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="FORMA SELECIONADA:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TipoPagamentoSelecionado}" Foreground="{DynamicResource AccentCyanBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                    </DockPanel>

                    <!-- Campo Valor Recebido -->
                    <TextBlock Text="VALOR RECEBIDO R$:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtValorPago" Text="{Binding ValorPagoInput, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Style="{StaticResource PdvTextBoxStyle}" AutomationProperties.Name="Valor recebido" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentYellowBrush}" Padding="10,6" Margin="0,0,0,16" />

                    <!-- Troco Calculado -->
                    <Border Background="{DynamicResource SaleAreaBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <DockPanel>
                            <TextBlock Text="TROCO R$:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TrocoCalculado, StringFormat=R$ {0:N2}}" Foreground="{DynamicResource AccentYellowBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>

                    <!-- Mensagem Erro Modal -->
                    <TextBlock x:Name="TxtErroPagamento" Text="{Binding MensagemErroModal}" Foreground="{DynamicResource DangerForegroundBrush}" AutomationProperties.Name="{Binding MensagemErroModal}" AutomationProperties.LiveSetting="Assertive" FontSize="13" FontWeight="Bold" Visibility="{Binding HasMensagemErroModal, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10" HorizontalAlignment="Center" />

                    <!-- Botões Ação Modal -->
                    <UniformGrid Columns="2">
                        <Button x:Name="BtnCancelarPagamento" Content="CANCELAR (ESC)" Command="{Binding FecharModalPagamentoCommand}" Style="{StaticResource NeutralButtonStyle}" AutomationProperties.Name="Cancelar pagamento" FontSize="14" Padding="12" Margin="0,0,6,0" />
                        <Button x:Name="BtnConfirmarPagamento" Content="CONFIRMAR (ENTER)" Command="{Binding ConfirmarPagamentoCommand}" IsDefault="True" Style="{StaticResource SuccessActionButtonStyle}" AutomationProperties.Name="Confirmar pagamento" FontSize="14" Padding="12" Margin="6,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </GroupBox>
    </Grid>
</Window>
