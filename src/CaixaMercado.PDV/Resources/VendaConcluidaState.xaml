                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#34D399" Offset="0.0" />
                                    <GradientStop Color="#10B981" Offset="1.0" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Viewbox>
                </Grid>

                <!-- Status de Transição -->
                <TextBlock Text="Preparando próximo atendimento..." Foreground="{DynamicResource MutedTextBrush}" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Triggers para disparar a animação SEMPRE que o controle ficar Visível -->
        <ControlTemplate.Triggers>
            <Trigger Property="Visibility" Value="Visible">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CartDepartTransform"
                                             Storyboard.TargetProperty="X"
                                             From="-120" To="480" Duration="0:0:1.6" AccelerationRatio="0.3" DecelerationRatio="0.3" />
                            <DoubleAnimation Storyboard.TargetName="DepartingCart"
                                             Storyboard.TargetProperty="Opacity"
                                             From="1.0" To="0.0" Duration="0:0:1.6" AccelerationRatio="0.3" DecelerationRatio="0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
