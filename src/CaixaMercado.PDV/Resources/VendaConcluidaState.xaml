<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Componente Reutilizável do Estado Venda Concluída (VendaConcluidaState) -->
    <ControlTemplate x:Key="VendaConcluidaStateTemplate">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                
                <!-- Circulo Animado Verde com Checkmark SVG -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="2" CornerRadius="70" Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CheckPulseScale" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="CheckPulseScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="1.0" To="1.05" Duration="0:0:1.2" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="CheckPulseScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="1.0" To="1.05" Duration="0:0:1.2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <!-- Ícone de Checkmark Vetorial (SVG Path) -->
                    <Path Data="M 9 16.17 L 4.83 12 L 3.41 13.41 L 9 19 L 21 7 L 19.59 5.59 Z"
                          Fill="#34D399" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Mensagem de Sucesso -->
                <TextBlock Text="VENDA FINALIZADA!" Foreground="#34D399" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Obrigado pela compra!" Foreground="#94A3B8" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20" />

                <!-- Card de Troco -->
                <Border Background="#020617" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Padding="20,12" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TROCO:" Foreground="#94A3B8" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding UltimoTrocoFinalizado, StringFormat=R$ {0:N2}}" Foreground="#F59E0B" FontSize="28" FontWeight="Black" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Status de Transição -->
                <TextBlock Text="Preparando próximo atendimento..." Foreground="#64748B" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
