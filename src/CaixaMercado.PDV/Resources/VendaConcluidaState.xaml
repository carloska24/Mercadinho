<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Componente Reutilizável do Estado Venda Concluída (VendaConcluidaState com Carrinho Partindo) -->
    <ControlTemplate x:Key="VendaConcluidaStateTemplate" TargetType="Control">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                
                <!-- Circulo Animado Verde com Checkmark SVG -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border Background="{DynamicResource SuccessContainerBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="2" CornerRadius="60" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CheckPulseScale" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="CheckPulseScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="1.0" To="1.05" Duration="0:0:1.2" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="CheckPulseScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="1.0" To="1.05" Duration="0:0:1.2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <!-- Ícone de Checkmark Vetorial (SVG Path) -->
                    <Path Data="M 9 16.17 L 4.83 12 L 3.41 13.41 L 9 19 L 21 7 L 19.59 5.59 Z"
                          Fill="#34D399" Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Mensagem de Sucesso -->
                <TextBlock Text="VENDA FINALIZADA!" Foreground="{DynamicResource AccentGreenBrush}" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Obrigado pela compra!" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16" />

                <!-- Card de Troco -->
                <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource AccentGreenBrush}" BorderThickness="1.5" CornerRadius="8" Padding="20,10" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TROCO:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding UltimoTrocoFinalizado, StringFormat=R$ {0:N2}}" Foreground="{DynamicResource AccentYellowBrush}" FontSize="26" FontWeight="Black" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ANIMAÇÃO DE SAÍDA DO CARRINHO PARTINDO (DESLOCAMENTO HORIZONTAL COM SVG OFICIAL fi_9725806 EM VERDE VIBRANTE) -->
                <Grid Height="100" Width="440" HorizontalAlignment="Center" Margin="0,4,0,12" ClipToBounds="True">
                    <Viewbox x:Name="DepartingCart" Width="90" Height="90" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Viewbox.RenderTransform>
                            <TranslateTransform x:Name="CartDepartTransform" X="0" Y="0" />
                        </Viewbox.RenderTransform>

                        <!-- SVG Oficial fi_9725806 solicitado com gradiente verde esmeralda adequado -->
