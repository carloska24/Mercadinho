<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Componente Reutilizável do Estado Venda Concluída (VendaConcluidaState com Carrinho Partindo) -->
    <ControlTemplate x:Key="VendaConcluidaStateTemplate">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                
                <!-- Circulo Animado Verde com Checkmark SVG -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="2" CornerRadius="60" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CheckPulseScale" ScaleX="1" ScaleY="1" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="CheckPulseScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         From="1.0" To="1.05" Duration="0:0:1.2" AutoReverse="True" />
                                        <DoubleAnimation Storyboard.TargetName="CheckPulseScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         From="1.0" To="1.05" Duration="0:0:1.2" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>

                    <!-- Ícone de Checkmark Vetorial (SVG Path) -->
                    <Path Data="M 9 16.17 L 4.83 12 L 3.41 13.41 L 9 19 L 21 7 L 19.59 5.59 Z"
                          Fill="#34D399" Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Mensagem de Sucesso -->
                <TextBlock Text="VENDA FINALIZADA!" Foreground="#34D399" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Obrigado pela compra!" Foreground="#94A3B8" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16" />

                <!-- Card de Troco -->
                <Border Background="#020617" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Padding="20,10" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TROCO:" Foreground="#94A3B8" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding UltimoTrocoFinalizado, StringFormat=R$ {0:N2}}" Foreground="#F59E0B" FontSize="26" FontWeight="Black" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ANIMAÇÃO DE SAÍDA DO CARRINHO PARTINDO (DESLOCAMENTO HORIZONTAL DA ESQUERDA PARA A DIREITA) -->
                <Grid Height="90" Width="420" HorizontalAlignment="Center" Margin="0,4,0,12" ClipToBounds="True">
                    <Viewbox x:Name="DepartingCart" Width="85" Height="85" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Viewbox.RenderTransform>
                            <TranslateTransform x:Name="CartDepartTransform" X="0" Y="0" />
                        </Viewbox.RenderTransform>
                        <Viewbox.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CartDepartTransform"
                                                         Storyboard.TargetProperty="X"
                                                         From="-90" To="420" Duration="0:0:1.5" AccelerationRatio="0.3" DecelerationRatio="0.3" />
                                        <DoubleAnimation Storyboard.TargetName="DepartingCart"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1.0" To="0.0" Duration="0:0:1.5" AccelerationRatio="0.3" DecelerationRatio="0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Viewbox.Triggers>

                        <!-- SVG Oficial fi_9725842 com preenchimento vibrante ciano/esmeralda -->
                        <Path Data="F0 m243.266 58.757 30.763 53.284v27.047h-61.527v-27.047zm210.175 96.331h-344.788l-16.275-67.413c-3.507-14.531-16.257-24.62-31.215-24.62h-34.191c-8.266 0-14.968 6.701-14.968 14.968 0 8.266 6.701 14.967 14.968 14.967h34.191c1.122 0 1.948.594 2.216 1.701l57.041 236.286c-22.432 7.775-37.709 29.008-37.709 52.871 0 30.227 24.226 55.004 54.243 55.903 4.603 22.277 24.331 39.022 47.971 39.022 23.63 0 43.351-16.732 47.965-38.995h85.312c4.614 22.263 24.334 38.995 47.965 38.995 27.054 0 48.985-21.931 48.985-48.985s-21.931-48.986-48.985-48.986c-19.951 0-37.114 11.928-44.752 29.041h-91.738c-7.638-17.113-24.801-29.041-44.752-29.041s-37.114 11.928-44.752 29.041h-1.531c-14.268 0-25.995-11.728-25.995-25.995 0-14.268 11.728-25.995 25.995-25.995h230.818c25.053 0 46.602-15.966 53.981-39.894l43.915-142.376c3.858-9.709-3.266-20.495-13.915-20.495zm-87.274 254.754c11.015 0 19.945 8.929 19.945 19.945 0 11.015-8.929 19.945-19.945 19.945-11.015 0-19.945-8.93-19.945-19.945 0-11.016 8.929-19.945 19.945-19.945zm-181.242 0c11.015 0 19.945 8.929 19.945 19.945 0 11.015-8.929 19.945-19.945 19.945-11.015 0-19.945-8.93-19.945-19.945 0-11.016 8.929-19.945 19.945-19.945zm11.356-81.925h-45.906l-9.678-40.091h55.585v40.091zm0-56.091h-59.447l-7.636-31.631h67.083zm0-47.631h-70.946l-9.456-39.172h80.402zm68.665 103.722h-52.665v-40.091h52.665zm0-56.091h-52.665v-31.631h52.665zm0-47.631h-52.665v-39.172h52.665zm68.665 103.722h-52.665v-40.091h52.665zm0-56.091h-52.665v-31.631h52.665zm0-47.631h-52.665v-39.172h52.665zm61.297 84.993c-3.542 11.486-13.447 18.729-25.449 18.729h-19.849v-40.091h51.887zm11.525-37.362h-56.822v-31.631h66.578zm14.691-47.631h-71.513v-39.172h83.595zm-17.06-144.727c-1.521-1.829-3.195-3.556-5.014-5.159l14.317-24.798c2.553-4.421 1.024-10.127-3.398-12.68-4.421-2.553-10.127-1.024-12.68 3.398l-14.317 24.798c-20.693-6.974-44.112 1.34-55.45 20.979-5.489 9.507-9.499 27.869-15.024 53.083h91.692c1.808-2.231 3.29-4.317 4.417-6.269 10.079-17.458 7.635-38.708-4.543-53.352zm-17.229 13.393c-2.209 3.814-7.092 5.115-10.906 2.906-7.523-4.343-17.169-1.738-21.51 5.78-2.209 3.814-7.092 5.115-10.906 2.906s-5.115-7.092-2.906-10.906c8.763-15.178 28.15-20.352 43.322-11.592 3.814 2.209 5.115 7.092 2.906 10.906zm-247.419-42.104h89.994l10.121-17.53h-100.115zm-22.764 69.284h79.851v19.047h-75.253zm103.521-53.284h-85.375l-21.526 37.284h85.375zm198.546 5.483.125-.216c9.764-2.456 20.313-.99 29.143 4.397.272-.127.544-.252.816-.376 2.845-8.6 3.118-17.512-.202-28.639-1.26-4.228 1.147-8.678 5.375-9.937 4.228-1.26 8.678 1.147 9.937 5.375 1.814 6.079 2.798 11.687 3.051 17.003l11.103-10.507c3.193-3.02 8.23-2.88 11.25.313s2.88 8.23-.313 11.25l-9.911 9.379c4.776.372 9.799 1.328 15.192 2.937 4.228 1.26 6.634 5.709 5.375 9.937-1.26 4.228-5.709 6.635-9.937 5.375-11.126-3.319-20.039-3.047-28.639-.203-.124.272-.249.544-.376.816 8.659 14.193 7.186 32.825-4.42 45.507l-28.196-6.727c5.843-18.955 2.362-39.695-9.373-55.684zm-150.902-17.605c32.328 12.197 37.52 26.444 32.104 41.482-4.694-7.762-12.578-10.848-26.318-16.814l16.427 28.452v31.334h6.072c.781-3.523 1.559-7.051 2.338-10.584 3.301-14.982 7.598-37.287 15.226-50.499 3.635-6.296 8.249-11.761 13.557-16.288-16.013-11.774-38.288-16.146-59.406-7.083z">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#38BDF8" Offset="0.0" />
                                        <GradientStop Color="#34D399" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                            </Path>
                        </Viewbox>
                    </Grid>

                <!-- Status de Transição -->
                <TextBlock Text="Preparando próximo atendimento..." Foreground="#64748B" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
