        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                
                <!-- Circulo com Ilustração Vetorial Monocromática de Carrinho (SVG Path) -->
                <Border Background="#16233B" BorderBrush="#33445C" BorderThickness="1.5" CornerRadius="56" Width="112" Height="112" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Path Data="M 19 6 H 5.21 L 4.27 2 H 1 V 4 H 2.73 L 6.13 18.47 C 5.45 18.84 5 19.56 5 20.38 C 5 21.48 5.9 22.38 7 22.38 C 8.1 22.38 9 21.48 9 20.38 C 9 19.98 8.88 19.61 8.68 19.31 H 16.32 C 16.12 19.61 16 19.98 16 20.38 C 16 21.48 16.9 22.38 18 22.38 C 19.1 22.38 20 21.48 20 20.38 C 20 19.34 19.2 18.48 18.18 18.4 H 7.21 L 6.74 16.4 H 19 L 22 6 H 19 Z M 7 21 C 6.66 21 6.38 20.72 6.38 20.38 C 6.38 20.04 6.66 19.76 7 19.76 C 7.34 19.76 7.62 20.04 7.62 20.38 C 7.62 20.72 7.34 21 7 21 Z M 18 21 C 17.66 21 17.38 20.72 17.38 20.38 C 17.38 20.04 17.66 19.76 18 19.76 C 18.34 19.76 18.62 20.04 18.62 20.38 C 18.62 20.72 18.34 21 18 21 Z M 18.14 14.4 H 6.27 L 4.74 8 H 19.58 L 18.14 14.4 Z"
                          Fill="#64748B" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Mensagem Principal de Estado -->
                <TextBlock Text="CAIXA LIVRE" Foreground="#CBD5E1" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Aguardando leitura do produto" Foreground="#64748B" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,16" />

                <!-- Dica de Atalho -->
                <Border Background="#1E293B" BorderBrush="#33445C" BorderThickness="1" CornerRadius="20" Padding="14,6" HorizontalAlignment="Center">
                    <TextBlock Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center">
                        <Run Text="F2" FontWeight="Bold" Foreground="#FACC15" />
                        <Run Text=" — Consultar produto" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
