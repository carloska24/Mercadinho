<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ESTADO VAZIO — CAIXA LIVRE (Scanner Edition)
         Redesign: substitui carrinho colorido (clipart genérico, 6 famílias de cor fora do design system)
         por ícone de scanner de código de barras (linguagem visual do design system, verde primário).

         Princípios aplicados:
         - Ícone contextual: o operador ESCANEIA produtos, não empurra carrinho
         - Monocromático: usa apenas AccentGreenBrush + PrimaryTextBrush (zero cores fora do sistema)
         - Animação funcional: scan line sobe/desce simulando leitura real
         - Glow radial: preenche o vazio branco opressivo sem poluir
         - Pulso no status: feedback visual de que o sistema está aguardando -->
    <ControlTemplate x:Key="EmptySaleStateTemplate">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">

            <!-- Glow radial de fundo: elimina o vazio opressivo sem poluir a tela -->
            <Ellipse Width="420" Height="320" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3010B981" Offset="0" />
                        <GradientStop Color="#0010B981"  Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">

                <!-- ================================================================
                     ÍCONE: SCANNER DE CÓDIGO DE BARRAS
                     Estrutura: Border arredondado (SuccessContainer) +
                     Canvas 72×72 com targeting reticle (4 cantos verdes) +
                     barcode (7 barras PrimaryText semi-opaco) +
                     scan line animada com gradiente horizontal (EasingFunction sine)
                     ================================================================ -->
                <Border Width="116" Height="116" CornerRadius="24"
                        Background="{DynamicResource SuccessContainerBrush}"
                        BorderBrush="{DynamicResource AccentGreenBrush}"
                        BorderThickness="1.5"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,22">
                    <Border.Effect>
                        <DropShadowEffect Color="#10B981" BlurRadius="18" ShadowDepth="0" Opacity="0.22" />
                    </Border.Effect>

                    <!-- Canvas 72×72: posição absoluta dos elementos do scanner -->
                    <Canvas Width="72" Height="72"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                        <!-- Targeting Reticle: 4 cantos estilo scanner profissional -->
                        <!-- Canto superior esquerdo -->
                        <Rectangle Canvas.Left="4"   Canvas.Top="4"   Width="16"  Height="2.5" Fill="{DynamicResource AccentGreenBrush}" />
                        <Rectangle Canvas.Left="4"   Canvas.Top="4"   Width="2.5" Height="16"  Fill="{DynamicResource AccentGreenBrush}" />
                        <!-- Canto superior direito -->
                        <Rectangle Canvas.Left="52"  Canvas.Top="4"   Width="16"  Height="2.5" Fill="{DynamicResource AccentGreenBrush}" />
                        <Rectangle Canvas.Left="65.5" Canvas.Top="4"  Width="2.5" Height="16"  Fill="{DynamicResource AccentGreenBrush}" />
                        <!-- Canto inferior esquerdo -->
                        <Rectangle Canvas.Left="4"   Canvas.Top="65.5" Width="16" Height="2.5" Fill="{DynamicResource AccentGreenBrush}" />
                        <Rectangle Canvas.Left="4"   Canvas.Top="52"   Width="2.5" Height="16" Fill="{DynamicResource AccentGreenBrush}" />
                        <!-- Canto inferior direito -->
                        <Rectangle Canvas.Left="52"  Canvas.Top="65.5" Width="16" Height="2.5" Fill="{DynamicResource AccentGreenBrush}" />
                        <Rectangle Canvas.Left="65.5" Canvas.Top="52"  Width="2.5" Height="16" Fill="{DynamicResource AccentGreenBrush}" />

                        <!-- Área do código de barras: Canvas interno ClipToBounds=True
                             confina a scan line dentro da área de leitura (não vaza para fora) -->
                        <Canvas Canvas.Left="14" Canvas.Top="18" Width="44" Height="36" ClipToBounds="True">

                            <!-- 7 barras com espessura variada (padrão de barcode real) -->
                            <Rectangle Canvas.Left="0"  Canvas.Top="0" Width="2" Height="36" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.45" />
                            <Rectangle Canvas.Left="5"  Canvas.Top="0" Width="4" Height="36" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.45" />
                            <Rectangle Canvas.Left="12" Canvas.Top="0" Width="2" Height="36" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.45" />
                            <Rectangle Canvas.Left="18" Canvas.Top="0" Width="5" Height="36" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.45" />
                            <Rectangle Canvas.Left="27" Canvas.Top="0" Width="2" Height="36" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.45" />
                            <Rectangle Canvas.Left="33" Canvas.Top="0" Width="4" Height="36" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.45" />
                            <Rectangle Canvas.Left="40" Canvas.Top="0" Width="2" Height="36" Fill="{DynamicResource PrimaryTextBrush}" Opacity="0.45" />

                            <!-- Linha de scan: gradiente horizontal (fade-in / fade-out nas bordas)
                                 simula o beam de leitura laser. Animação SineEase 0→33→0 em 1.5s. -->
                            <Rectangle x:Name="ScanLine"
                                       Canvas.Left="-1" Canvas.Top="0"
                                       Width="46" Height="3"
                                       RadiusX="1.5" RadiusY="1.5">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#0010B981" Offset="0"    />
                                        <GradientStop Color="#CC10B981" Offset="0.28" />
                                        <GradientStop Color="#FF6EE7B7" Offset="0.5"  />
                                        <GradientStop Color="#CC10B981" Offset="0.72" />
                                        <GradientStop Color="#0010B981" Offset="1"    />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform x:Name="ScanTranslate" Y="0" />
                                </Rectangle.RenderTransform>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetName="ScanTranslate"
                                                    Storyboard.TargetProperty="Y"
                                                    From="0" To="33"
                                                    Duration="0:0:1.5"
                                                    AutoReverse="True">
                                                    <DoubleAnimation.EasingFunction>
                                                        <SineEase EasingMode="EaseInOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>

                        </Canvas>
                    </Canvas>
                </Border>

                <!-- ================================================================
                     TÍTULO PRINCIPAL
                     ================================================================ -->
                <TextBlock Text="CAIXA LIVRE"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="23" FontWeight="Black"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <!-- ================================================================
                     STATUS: SCANNER PRONTO
                     Ponto sólido + anel de pulso animado (expand + fade-out em 1.8s)
                     ================================================================ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <!-- Grid 16×16 para sobrepor ponto sólido + anel de pulso -->
                    <Grid Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                        <!-- Anel de pulso (expande e some, simula "heartbeat" do scanner) -->
                        <Ellipse x:Name="PulseRing"
                                 Width="16" Height="16"
                                 Stroke="{DynamicResource SuccessForegroundBrush}"
                                 StrokeThickness="1.5"
                                 Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="RingScale" ScaleX="0.8" ScaleY="0.8" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="RingScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.7" To="2.5"
                                                             Duration="0:0:1.8" />
                                            <DoubleAnimation Storyboard.TargetName="RingScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.7" To="2.5"
                                                             Duration="0:0:1.8" />
                                            <DoubleAnimation Storyboard.TargetName="PulseRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.65" To="0"
                                                             Duration="0:0:1.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <!-- Ponto sólido central -->
                        <Ellipse Width="10" Height="10"
                                 Fill="{DynamicResource SuccessForegroundBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="SCANNER PRONTO"
                               Foreground="{DynamicResource SuccessForegroundBrush}"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- ================================================================
                     INSTRUÇÃO OPERACIONAL
                     ================================================================ -->
                <TextBlock Text="Aproxime o produto ao scanner ou digite o código manualmente"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16" />

                <!-- ================================================================
                     HINT F2: visual com CornerRadius=6 (consistente com o design system)
                     Pill shape substituído por rounded-rect para alinhamento com o resto da UI
                     ================================================================ -->
                <Border Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource AccentBlueBrush}"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="14,7"
                        HorizontalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center">
                        <Run Text="F2" FontWeight="Bold" Foreground="{DynamicResource AccentYellowBrush}" />
                        <Run Text=" — Consultar produto" Foreground="{DynamicResource AccentCyanBrush}" />
                    </TextBlock>
                </Border>

            </StackPanel>
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
