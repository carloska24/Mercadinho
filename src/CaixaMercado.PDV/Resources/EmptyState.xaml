                <!-- Mensagem Principal de Estado -->
                <TextBlock Text="CAIXA LIVRE" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="23" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,4" />
                
                <!-- Status Operacional -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessForegroundBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="SCANNER PRONTO" Foreground="{DynamicResource SuccessForegroundBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Aproxime o produto do scanner ou digite o código manualmente" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,10,0" />

                <!-- Dica de Atalho com Destaque -->
                <Border Background="{DynamicResource SaleAreaBackgroundBrush}" BorderBrush="{DynamicResource AccentBlueBrush}" BorderThickness="1.5" CornerRadius="20" Padding="12,6" HorizontalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource AccentCyanBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center">
                        <Run Text="F2" FontWeight="Bold" Foreground="{DynamicResource AccentYellowBrush}" />
                        <Run Text=" — Consultar produto" />
                    </TextBlock>
                </Border>
