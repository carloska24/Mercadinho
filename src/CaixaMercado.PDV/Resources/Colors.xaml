<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores Principais do PDV (Slate & Navy) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#020617" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3B82F6" />
    
    <!-- Texto -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />

    <!-- Cores de Ação & Status -->
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#10B981" />
    <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="#059669" />
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="DataGridRowAlternateBackgroundBrush" Color="#182238" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="DataGridRowSelectedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#1E293B" />

</ResourceDictionary>
