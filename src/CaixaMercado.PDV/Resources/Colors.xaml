<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta Oficial ERP / PDV Corporativo (PDV_FINAL_TEMA_E_EMPTY_STATE.md) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#182235" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#25334A" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#202C40" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#33445C" />
    <SolidColorBrush x:Key="SaleAreaBackgroundBrush" Color="#10192B" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#080F1E" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2563EB" />
    
    <!-- Texto -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />

    <!-- Cores Semânticas de Ação & Status -->
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#10B981" />
    <SolidColorBrush x:Key="AccentGreenHoverBrush" Color="#059669" />
    <SolidColorBrush x:Key="AccentYellowBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="#EF4444" />

    <!-- DataGrid do Cupom Fiscal -->
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#25334A" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#10192B" />
    <SolidColorBrush x:Key="DataGridRowAlternateBackgroundBrush" Color="#16233B" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="DataGridRowSelectedForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#1E2B42" />

</ResourceDictionary>
